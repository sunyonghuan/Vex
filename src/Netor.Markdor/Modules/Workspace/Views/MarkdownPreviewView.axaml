<UserControl
    x:Class="Netor.Markdor.Modules.Workspace.Views.MarkdownPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="https://codewf.com"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Netor.Markdor"
    xmlns:vm="using:Netor.Markdor.Modules.Workspace.ViewModels"
    xmlns:views="using:Netor.Markdor.Modules.Workspace.Views"
    xmlns:markdor="clr-namespace:Netor.Markdor.Controls;assembly=Markdor.Controls"
    x:DataType="vm:MarkdownPreviewViewModel">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource MarkdorPreviewBackgroundBrush}">
        <!-- 预览窗格头：标注窗格身份 + 当前排版主题（对应原型 .pane-head + .kbd）。
             工作台组合布局下由 WorkspaceViewController 统一提供窗格头，此处作为独立使用时的兜底。 -->
        <Border x:Name="PaneHeader" Classes="pane-head">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path
                        Classes="stroke-ico"
                        Width="12"
                        Height="12"
                        Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                    <TextBlock Classes="pane-title" Text="{i18n:I18n {x:Static l:MarkdorL.PreviewPaneTitle}}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="kbd-chip">
                    <TextBlock Text="{Binding TypographyTheme, TargetNullValue=Basic}" />
                </Border>
            </Grid>
        </Border>
        <ScrollViewer
            x:Name="PreviewScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto" Focusable="True">
            <!-- 包裹层：ScrollViewer 会拉伸直接子级，居中限宽需交给内层 Grid 的对齐处理。 -->
            <Grid HorizontalAlignment="Stretch">
            <LayoutTransformControl x:Name="DocumentTransform">
            <md:MarkdownViewer
                x:Name="PreviewMarkdownViewer"
                IsTaskEditingEnabled="{Binding IsTaskEditingEnabled}"
                Margin="30 22 30 64"
                ImageBasePath="{Binding ImageBasePath}"
                Markdown="{Binding Markdown}"
                SyntaxOptions="{Binding Preferences.SyntaxOptions}"
                ContentFontFamily="{Binding Preferences.ContentFontFamily}"
                ParagraphFontSize="{Binding BodyFontSize}"
                CodeBlockFontSize="{Binding Preferences.EffectiveCodeFontSize}"
                CodeBlockWrap="{Binding Preferences.CodeWrap}"
                TypographySize="{Binding TypographySize}"
                TypographyTheme="{Binding TypographyTheme}" />
            </LayoutTransformControl>
            </Grid>
        </ScrollViewer>
        <views:WatermarkOverlay Grid.Row="1" IsVisible="{Binding Preferences.WatermarkPreview}"
                                Text="{Binding Preferences.WatermarkText}" Strength="{Binding Preferences.WatermarkOpacity}"
                                FontSize="{Binding Preferences.WatermarkFontSize}" HexInk="{Binding Preferences.WatermarkColor}"
                                WeightValue="{Binding Preferences.WatermarkWeight}" />
        <markdor:MarkdorZoomDock x:Name="ReadingZoomDock" Grid.Row="1" ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 IsVisible="{Binding ShowReadingDock}" Margin="{Binding ReadingDockMargin}"
                                 Minimum="50" Maximum="200" Step="5" Value="{Binding Preferences.ContentZoom, Mode=TwoWay}"
                                 Label="{i18n:I18n {x:Static l:MarkdorL.PrefZoom}}"
                                 ResetLabel="{i18n:I18n {x:Static l:MarkdorL.ZoomRestoreFont}}"
                                 ResetGeometry="{StaticResource WBFitIcon}" markdor:MarkdorBottomAxis.CenterFromBottom="69" />
    </Grid>


</UserControl>
