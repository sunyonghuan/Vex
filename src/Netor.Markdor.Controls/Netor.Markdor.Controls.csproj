<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <Title>Markdor.Controls</Title>
    <Description>Markdor product controls and theme resources for Avalonia applications.</Description>
    <PackageId>Markdor.Controls</PackageId>
    <AssemblyName>Markdor.Controls</AssemblyName>
    <RootNamespace>Netor.Markdor.Controls</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Semi.Avalonia" />
  </ItemGroup>
</Project>
